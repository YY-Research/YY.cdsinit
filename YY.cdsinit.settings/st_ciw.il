procedure( YY_ciw_settings()
    ;; CIW keybindings
    hiSetFont("ciw" ?size 16)
    hiSetFont("label" ?name "Open Sans" ?size 16)
    hiSetFont("text" ?name "Open Sans" ?size 16)
)